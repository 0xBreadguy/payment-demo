# MegaETH testnet RPC (override default https://carrot.megaeth.com/rpc)
NEXT_PUBLIC_MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# Server-side signer for on-chain writes. DO NOT commit. Hex, with or without 0x prefix.
# Used by: /api/relay, /api/faucet (mint), x402 facilitator, MPP gasless routes, and MPP session close.
SERVER_PRIVATE_KEY=

# USDm token address. Required. Public so client can read balance and call faucet.
# Used by x402 + mpp + mpp-session as the payment token.
NEXT_PUBLIC_USDM_ADDRESS=0x15e9f2B0A747aC05c7446559306687085D161e5C

# Recipient of all USDm payments (x402 / mpp / mpp-session).
# Defaults to SERVER_PRIVATE_KEY's address. For MPP session close, this must match SERVER_PRIVATE_KEY's address.
PAY_TO=

# --- x402 ---
# Optional EIP-712 domain version fallback. The route prefers token eip712Domain().
NEXT_PUBLIC_X402_TOKEN_VERSION=1
# Absolute facilitator URL (defaults to <origin>/api/x402/facilitator).
X402_FACILITATOR_URL=

# --- mpp ---
# HMAC secret used by mppx to sign 402 challenges. Required for MPP charge routes.
MPP_SECRET_KEY=
# Human-readable amount of USDm to charge (default 1).
MPP_CHARGE_AMOUNT=1

# --- mpp gasless charge (permit20 / EIP-2612) ---
# Optional gasless one-time amount. Defaults to MPP_CHARGE_AMOUNT, then 1.
MPP_GASLESS_CHARGE_AMOUNT=1
# Optional EIP-712 token domain version override for permit(owner, spender, value, nonce, deadline).
# By default the gasless route reads eip712Domain()/name() from the token.
NEXT_PUBLIC_MPP_GASLESS_TOKEN_VERSION=1

# --- mpp session (pay-as-you-go official + gasless) ---
# Deployed TempoStreamChannelEvm escrow on MegaETH testnet. Required for /api/mpp/session and /api/mpp/session-gasless.
NEXT_PUBLIC_MPP_SESSION_ESCROW=0x0f6D01477d0745F6D6cf101A0409868e76caf35C
MPP_SESSION_ESCROW=0x0f6D01477d0745F6D6cf101A0409868e76caf35C
# Per-request unit price in human USDm (default 1).
NEXT_PUBLIC_MPP_SESSION_REQUEST_AMOUNT=1
MPP_SESSION_REQUEST_AMOUNT=1
# Initial channel deposit in human USDm (default 10).
NEXT_PUBLIC_MPP_SESSION_DEPOSIT_AMOUNT=5
MPP_SESSION_DEPOSIT_AMOUNT=5
