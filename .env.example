# MegaETH testnet RPC (override default https://carrot.megaeth.com/rpc)
NEXT_PUBLIC_MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# WalletConnect Cloud project id — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side signer for on-chain writes. DO NOT commit. Hex, with or without 0x prefix.
# Used by: /api/relay, /api/faucet (mint), x402 facilitator (verify+settle, sponsors gas).
SERVER_PRIVATE_KEY=

# USDm token address. Required. Public so client can read balance and call faucet.
# Used by x402 + mpp + mpp-session as the payment token.
NEXT_PUBLIC_USDM_ADDRESS=

# Recipient of all USDm payments (x402 / mpp / mpp-session).
# Defaults to SERVER_PRIVATE_KEY's address.
PAY_TO=

# --- x402 ---
# EIP-712 domain name + version for the token (must match the contract).
NEXT_PUBLIC_X402_TOKEN_NAME=USDm
NEXT_PUBLIC_X402_TOKEN_VERSION=1
# Absolute facilitator URL (defaults to <origin>/api/x402/facilitator).
X402_FACILITATOR_URL=

# --- mpp ---
# HMAC secret used by mppx to sign 402 challenges. Required for MPP charge routes.
MPP_SECRET_KEY=
# Human-readable amount of USDm to charge (default 1).
MPP_CHARGE_AMOUNT=

# --- mpp gasless charge (permit20 / EIP-2612) ---
# Optional gasless one-time amount. Defaults to MPP_CHARGE_AMOUNT, then 1.
MPP_GASLESS_CHARGE_AMOUNT=
# Optional EIP-712 token domain overrides for permit(owner, spender, value, nonce, deadline).
# By default the gasless route reads eip712Domain()/name() from the token.
NEXT_PUBLIC_MPP_GASLESS_TOKEN_NAME=
NEXT_PUBLIC_MPP_GASLESS_TOKEN_VERSION=

# --- mpp session (pay-as-you-go) ---
# Deployed TempoStreamChannelEvm escrow on MegaETH testnet. Required.
NEXT_PUBLIC_MPP_SESSION_ESCROW=
MPP_SESSION_ESCROW=
# Per-request unit price in human USDm (default 1).
NEXT_PUBLIC_MPP_SESSION_REQUEST_AMOUNT=
MPP_SESSION_REQUEST_AMOUNT=
# Initial channel deposit in human USDm (default 10).
NEXT_PUBLIC_MPP_SESSION_DEPOSIT_AMOUNT=
MPP_SESSION_DEPOSIT_AMOUNT=
