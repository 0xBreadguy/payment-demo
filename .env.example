# MegaETH testnet RPC (override default https://carrot.megaeth.com/rpc)
NEXT_PUBLIC_MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# WalletConnect Cloud project id — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side signer for on-chain writes. DO NOT commit. Hex, with or without 0x prefix.
# Used by: /api/relay, /api/faucet (mint), x402 facilitator (verify+settle, sponsors gas).
SERVER_PRIVATE_KEY=

# USDm token (override the built-in default 0x15e9f2B0A747aC05c7446559306687085D161e5C).
# Public so client can read balance and call faucet for the right contract.
NEXT_PUBLIC_USDM_ADDRESS=

# --- x402 ---
# Recipient of the 1 USDm payment. Defaults to SERVER_PRIVATE_KEY's address.
NEXT_PUBLIC_X402_PAY_TO=
# Override token contract used by x402 (defaults to NEXT_PUBLIC_USDM_ADDRESS).
NEXT_PUBLIC_X402_TOKEN_ADDRESS=
# EIP-712 domain name + version for the token (must match the contract).
NEXT_PUBLIC_X402_TOKEN_NAME=USDm
NEXT_PUBLIC_X402_TOKEN_VERSION=1
# Absolute facilitator URL (defaults to <origin>/api/x402/facilitator).
X402_FACILITATOR_URL=

# --- mpp ---
# HMAC secret used by mppx to sign 402 challenges. Required to enable /api/mpp/charge.
MPP_SECRET_KEY=
# Recipient of the 1 USDm MPP payment. Falls back to NEXT_PUBLIC_X402_PAY_TO,
# X402_PAY_TO, or SERVER_PRIVATE_KEY's address.
MPP_PAY_TO=
# Optional client-visible MPP recipient override.
NEXT_PUBLIC_MPP_PAY_TO=
# Human-readable amount of USDm to charge (default 1).
MPP_CHARGE_AMOUNT=

# --- mpp session (pay-as-you-go) ---
# Deployed TempoStreamChannelEvm escrow on MegaETH testnet.
NEXT_PUBLIC_MPP_SESSION_ESCROW=0x6572BFEA6B6EFB653D53F3a787B5e159d2365b69
MPP_SESSION_ESCROW=0x6572BFEA6B6EFB653D53F3a787B5e159d2365b69
# Per-request unit price in human USDm (default 0.01).
NEXT_PUBLIC_MPP_SESSION_REQUEST_AMOUNT=
MPP_SESSION_REQUEST_AMOUNT=
# Initial channel deposit in human USDm (default 0.10).
NEXT_PUBLIC_MPP_SESSION_DEPOSIT_AMOUNT=
MPP_SESSION_DEPOSIT_AMOUNT=
# Recipient (payee) for session settlements. Falls back to MPP_PAY_TO,
# X402_PAY_TO, then SERVER_PRIVATE_KEY's address.
MPP_SESSION_PAY_TO=

